# ────────────────────────────────────────────────────────────
# NutriBot — IBM Granite Nutrition AI — Environment Config
# ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your IBM watsonx.ai credentials.
# The application works in rule-based demo mode without credentials.
# ────────────────────────────────────────────────────────────

# IBM watsonx.ai API Key (from IBM Cloud → Manage → API Keys)
WATSONX_API_KEY=

# IBM watsonx.ai Project ID (from watsonx.ai → Projects → your project → Manage)
WATSONX_PROJECT_ID=

# Optional: override the default API endpoint (us-south region is default)
# WATSONX_API_URL=https://us-south.ml.cloud.ibm.com/ml/v1/text/generation?version=2023-05-29

# Flask settings
PORT=5000
FLASK_DEBUG=false
